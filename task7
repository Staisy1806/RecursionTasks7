
#include <iostream>
using namespace std;

class Program
{
public:

    static bool CheckDouble(int arr[], int size, int i, int j)
    {
        if (i == size)
            return false;

        if (j == size)
            return CheckDouble(arr, size, i + 1, 0);

        if (i != j && arr[i] == 2 * arr[j])
            return true;

        return CheckDouble(arr, size, i, j + 1);
    }
};

int main()
{
    int arr[] = { 10, 2, 5, 3 };

    int size = sizeof(arr) / sizeof(arr[0]);

    cout << boolalpha;
    cout << Program::CheckDouble(arr, size, 0, 0);

    return 0;
}
